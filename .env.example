# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== Tushare (可选数据源) =====
# 配置后可在「设置 → 数据源」中安装/切换 Tushare。
# Tushare 负责日线、复权因子、财务和标的维表；盘中实时行情仍使用其他实时源。
TUSHARE_TOKEN=

# Tushare 连接模式: official | promax
# official: 官方 SDK 或兼容 pro_api 的代理
# promax:   GET 聚合网关
TUSHARE_MODE=official

# official 模式可选: 兼容 pro_api 的代理地址
TUSHARE_HTTP_URL=

# promax 模式填写以下两项
TUSHARE_PROMAX_URL=
TUSHARE_PROMAX_KEY=
# 若聚合网关使用自签或中转证书，请设为 0；官方可信证书可保持 1。
TUSHARE_PROMAX_VERIFY_TLS=1
# datahubco 15000-point gateway. The key may be left blank when it is the same
# as TUSHARE_PROMAX_KEY. It is used as the extension/query backup, not for auction.
TUSHARE_DATAHUB_ENABLED=0
TUSHARE_DATAHUB_URL=https://datahubco.com/app-api/openapi/v1/tushare
TUSHARE_DATAHUB_KEY=
TUSHARE_DATAHUB_VERIFY_TLS=0
# 离线导入的 Tushare 扩展数据会在盘前/盘后任务中自动做尾部增量补齐。
# current=跟随 TUSHARE_MODE；official=官方 SDK/官方代理；promax=GET 聚合网关。
TUSHARE_EXT_MODE=current
# 扩展接口故障切换顺序；datahub 仅在前一源抛错时接管，空结果不会触发切换。
TUSHARE_EXT_SOURCE_CHAIN=promax,datahub
# 留空使用默认清单：涨跌停、龙虎榜、资金流、板块日线、筹码概要、业绩预告/快报、大宗交易、股东户数、融资融券。
TUSHARE_EXT_AUTO_APIS=
# 单个扩展接口超时秒数。Promax/代理偶发卡住时，短超时可以避免拖死整条同步链。
TUSHARE_EXT_TIMEOUT_SECONDS=12
# Promax minute fallback: tdx; blank keeps the original single-provider route.
MINUTE_FALLBACK_PROVIDER=
# Public L1 backup only; preserve selected primary providers.
PUBLIC_MARKET_FALLBACK_ENABLED=false
PUBLIC_MARKET_FALLBACK_MAX_SYMBOLS=100
PUBLIC_MARKET_FALLBACK_MAX_AGE_S=180
# 雪球末级实时/日K备源。实时快照可匿名；历史日K可填 xq_a_token 或完整 Cookie。
XUEQIU_TOKEN=
XUEQIU_COOKIE=
XUEQIU_TIMEOUT_SECONDS=8

# ===== News =====
# 国内历史新闻默认调用 Tushare news 接口,可填多个 src,逗号分隔。
# 不同账户/网关权限不同；系统会在显式源为空时继续尝试 fallback 源。
TUSHARE_NEWS_SRC=cls,10jqka
TUSHARE_NEWS_FALLBACK_SRC=cls,sina,10jqka
# 海外/美股历史新闻。配置后按时间窗口归档;未配置时仅保存公开 RSS 的近期内容。
ALPHAVANTAGE_API_KEY=
NEWS_SYNC_DELAY_S=0.25
# Tushare news 为空时，使用 AI Agents 的东方财富/新浪/财联社抓取近期新闻。
# 留空则取自选股；建议显式填写需要持续跟踪的标的，避免对公开源做全市场请求。
AIAGENTS_NEWS_SYMBOLS=
AIAGENTS_NEWS_MAX_SYMBOLS=30
AIAGENTS_NEWS_DELAY_S=0.2

# ===== 本地 TDX HTTP API（可选，实时/分钟K） =====
# 旧 aiagents-stock 接口为 /api/health、/api/quote、/api/kline、/api/search。
# Docker Desktop 内访问 Windows 主机请用 host.docker.internal；原生运行可用 127.0.0.1。
TDX_ENABLED=1
# Docker Compose 内置 tdx-api 服务；容器内主应用使用服务名访问。
TDX_BASE_URL=http://tdx-api:8080
TDX_TIMEOUT_SECONDS=8
# 暴露给 Windows 宿主机的本地检查地址：http://127.0.0.1:8080/api/health
TDX_API_HOST_PORT=127.0.0.1:8080
TDX_CONNECT_TIMEOUT=3
TDX_HOSTS=180.153.18.170:7709,119.147.212.81:7709,119.97.185.5:7709,101.227.73.20:7709,180.153.39.51:7709,14.215.128.18:7709
# 旧接口价格/成交额单位为厘，成交量单位为手；系统内部成交量也统一为手。
TDX_PRICE_SCALE=1000
TDX_AMOUNT_SCALE=1000
TDX_VOLUME_SCALE=1

# ===== 国信 QMT 本地桥（盘中实时/五档/分钟K） =====
# 先启动 HTTP bridge，再在 iQuant 内运行只读 ContextInfo 采集策略。
# 快照推送不冒充逐笔成交；L2委托/撤单/成交需另行验证权限并接入专用通道。
QMT_ENABLED=0
QMT_BASE_URL=http://host.docker.internal:8188
QMT_TIMEOUT_SECONDS=12
# QMT 股票成交量及五档委托量以手返回，系统内部也统一为手。
QMT_VOLUME_SCALE=1
# 可选：桥接服务与 Docker 两侧填写相同密钥。
QMT_BRIDGE_API_KEY=

# 资金流/集合竞价达到该全市场覆盖率后可供预测使用；缺失清单仍保留待补。
CLOSE_DATA_MIN_COVERAGE=0.99

# Optional third route for verified CLOSED stock-day 1m gaps only.
# Never use the public StockDB demo here. Local service/data sync is separate.
STOCKDB_ENABLED=0
STOCKDB_BASE_URL=http://host.docker.internal:7899
STOCKDB_HOST_PORT=127.0.0.1:8189
STOCKDB_MINUTE_FALLBACK_ENABLED=0
STOCKDB_AFTER_CLOSE_PRIMARY_ENABLED=0
STOCKDB_TIMEOUT_SECONDS=3
STOCKDB_MAX_STOCK_DAYS=100
MAINTENANCE_MINUTE_BATCH_SIZE=500
# 当天分钟为空时，收盘后/22:00/次日早盘最多自动重试次数。
MINUTE_CURRENT_DAY_MAX_RETRIES=3
# 全市场分钟补差每批之间释放重任务执行槽，避免后台维护长期占用前台操作。
MAINTENANCE_BULK_MINUTE_COOLDOWN_SECONDS=15
# 全市场分钟历史补差从该小时开始；候选股分钟确认不受此限制。
MAINTENANCE_BULK_MINUTE_START_HOUR=21
STOCKDB_ONLINE_FALLBACK_SYMBOLS=5
STOCKDB_READINESS_SAMPLE_SIZE=10
STOCKDB_READINESS_MIN_COVERAGE=0.60
STOCKDB_PUBLICATION_RETRY_SECONDS=600
STOCKDB_AUTO_UPDATE_ENABLED=0
STOCKDB_UPDATE_TRIGGER=/work/update.trigger
# 完整快照下载成功后，还需确认计划日期的240根常规分钟K已发布，才切换到新快照。
STOCKDB_UPDATE_READINESS_MODE=full
STOCKDB_UPDATE_DATA_DIR=/app-data
STOCKDB_UPDATE_READINESS_SYMBOLS=000001,000333,000651,000858,300750,600000,600519,601318,688981
STOCKDB_UPDATE_READINESS_MIN_BARS=240
STOCKDB_UPDATE_READINESS_TIMEOUT_SECONDS=5
STOCKDB_UPDATE_READINESS_MAX_WORKERS=16
# 单个 StockDB 更新轮次最长运行时间；上游资源卡住后进入退避，不阻塞分钟补差队列。
STOCKDB_UPDATER_TIMEOUT_SECONDS=180

# ===== stock-sdk (可选, 有合规风险) =====
# 需要重建镜像后才生效。开启后可把日线/复权/分钟/实时切到 stock-sdk，
# 用来节省 Tushare 积分, 但请自行评估第三方行情源的版权与稳定性。
INCLUDE_STOCKSDK=0

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
# 源码运行按项目根目录解析；Docker 相对路径按 /app 解析。
# Docker 推荐显式设置 DATA_DIR=/app/data，并把宿主机目录挂载到同一路径。
DATA_DIR=./data
# Docker 离线包挂载目录；主机放这里，容器内用 /app/offline-data 读取。
OFFLINE_DATA_HOST=../offline-data

# ===== StockFormer =====
# 默认预测/AI推荐会跳过盘中实时写盘造成的稀疏最新截面。
# 例如今天只刷新了自选股 4 只，则自动使用最近一个覆盖不少于 500 只的交易日。
STOCKFORMER_MIN_CROSS_SECTION_SYMBOLS=500
STOCKFORMER_CROSS_SECTION_LOOKBACK_DAYS=45

# ===== AI Agents =====
AIAGENTS_ENABLE=1
